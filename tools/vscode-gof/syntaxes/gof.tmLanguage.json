{
  "name": "gof",
  "scopeName": "source.gof",
  "fileTypes": [
    "gof"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#moduleDeclaration"
    },
    {
      "include": "#importDeclaration"
    },
    {
      "include": "#typeDeclarations"
    },
    {
      "include": "#receiverMethodDeclarations"
    },
    {
      "include": "#functionDeclarations"
    },
    {
      "include": "#resultVariants"
    },
    {
      "include": "#enumVariants"
    },
    {
      "include": "#builtinFunctions"
    },
    {
      "include": "#builtinTypes"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#typeIdentifiers"
    },
    {
      "include": "#functionCalls"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.gof",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.gof",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.gof"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.gof"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.gof",
              "match": "\\\\(?:[\"nt\\\\]|.)"
            }
          ]
        }
      ]
    },
    "moduleDeclaration": {
      "patterns": [
        {
          "name": "meta.declaration.module.gof",
          "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.module.gof"
            },
            "2": {
              "name": "entity.name.namespace.gof"
            }
          }
        }
      ]
    },
    "importDeclaration": {
      "patterns": [
        {
          "name": "meta.import.gof",
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.import.gof"
            },
            "2": {
              "name": "entity.name.namespace.gof"
            }
          }
        }
      ]
    },
    "typeDeclarations": {
      "patterns": [
        {
          "name": "meta.declaration.type.gof",
          "match": "\\b(struct|enum|protocol)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.declaration.gof"
            },
            "2": {
              "name": "entity.name.type.gof"
            }
          }
        }
      ]
    },
    "receiverMethodDeclarations": {
      "patterns": [
        {
          "name": "meta.function.method.gof",
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.gof"
            },
            "2": {
              "name": "entity.name.type.gof"
            },
            "3": {
              "name": "punctuation.accessor.dot.gof"
            },
            "4": {
              "name": "entity.name.function.gof"
            }
          }
        }
      ]
    },
    "functionDeclarations": {
      "patterns": [
        {
          "name": "meta.function.gof",
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.gof"
            },
            "2": {
              "name": "entity.name.function.gof"
            }
          }
        }
      ]
    },
    "resultVariants": {
      "patterns": [
        {
          "name": "meta.result.variant.gof",
          "match": "\\b(Result)(\\s*\\.\\s*)(Ok|Err)\\b",
          "captures": {
            "1": {
              "name": "support.type.builtin.gof"
            },
            "2": {
              "name": "punctuation.accessor.dot.gof"
            },
            "3": {
              "name": "constant.other.enum-variant.gof"
            }
          }
        }
      ]
    },
    "enumVariants": {
      "patterns": [
        {
          "name": "meta.enum.variant.gof",
          "match": "\\b([A-Z][A-Za-z0-9_]*)(\\s*\\.\\s*)([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.type.gof"
            },
            "2": {
              "name": "punctuation.accessor.dot.gof"
            },
            "3": {
              "name": "constant.other.enum-variant.gof"
            }
          }
        }
      ]
    },
    "builtinFunctions": {
      "patterns": [
        {
          "name": "support.function.builtin.gof",
          "match": "\\b(?:print|assert|argv|read_stdin|read_stdin_lines|env|cwd|run_process|read_file|write_file|read_lines|write_lines|exists|read_dir|mkdir|remove_file|path_join|path_dir|path_base|path_ext|dict|insert|keys|values|append|first|last|slice|reverse|sort|min|max|contains|trim|split|join|starts_with|ends_with|parse_int|to_string|range|sleep|channel|close|send|recv|cancel_token|cancel|is_cancelled|timeout_token|cancel_after|json_parse|json_stringify|json_get|json_index|json_len|json_string|json_int|toml_parse|csv_parse|csv_stringify|template_render|http_get|http_post|await_result)\\b(?=\\s*\\()"
        }
      ]
    },
    "builtinTypes": {
      "patterns": [
        {
          "name": "support.type.builtin.gof",
          "match": "\\b(?:int|string|bool|unit|json|cancel_token|list|dict|channel|task|Result|RuntimeError)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.gof",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.gof",
          "match": "\\b(?:if|else|while|for|in|match|return|break|continue|module|import)\\b"
        },
        {
          "name": "keyword.control.concurrent.gof",
          "match": "\\b(?:go|await|select|default)\\b"
        },
        {
          "name": "storage.modifier.gof",
          "match": "\\b(?:mut|async|defer|unsafe)\\b"
        },
        {
          "name": "keyword.operator.logical.gof",
          "match": "\\b(?:and|or|not)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.decimal.gof",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.gof",
          "match": "->|==|!=|<=|>=|[=<>?:,+\\-*/%]"
        }
      ]
    },
    "typeIdentifiers": {
      "patterns": [
        {
          "name": "entity.name.type.gof",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functionCalls": {
      "patterns": [
        {
          "name": "entity.name.function.call.gof",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()"
        }
      ]
    }
  }
}
