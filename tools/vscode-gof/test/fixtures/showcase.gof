module:
    sample_generics
    describe

const MAX_SIZE: int = 10
const GREETING: string = "hello"

import bytes
import io
import time
import net

enum JobState:
    Ready
    Running(pid: int)
    Failed(message: string)

struct Runner:
    id: int

fn Runner.run(self: Runner, job: task[int]) -> Result[int, RuntimeError]:
    mut ch: channel[int] = channel(1)
    select:
        result = recv(ch, timeout_token(5)):
            value = result?
            return await_result(go compute(value), cancel_token())
        default:
            return Result.Err(RuntimeError.Cancelled)

fn compute(value: int) -> int:
    if value > 0 and not false:
        return value
    else:
        return 0

fn find_first(items: list[int]) -> Option[int]:
    if len(items) > 0:
        return Option.Some(items[0])
    return Option.None

fn load_config(path: string) -> Result[json, RuntimeError]:
    lines = read_lines(path)?
    text = join(lines, "\n")
    return toml_parse(text)

fn encode_rows(rows: list[list[string]]) -> Result[string, RuntimeError]:
    csv = csv_stringify(rows)?
    return Result.Ok(csv)

# syntax smoke

fn spawn_tool(path: string) -> Result[json, RuntimeError]:
    return run_process(path, ["--help"])

fn render_notice(data: json) -> Result[string, RuntimeError]:
    return template_render("{{name}}", data)

fn consume_stdin() -> Result[list[string], RuntimeError]:
    text = read_stdin()?
    lines = read_stdin_lines()?
    assert(len(text) >= len(lines), "stdin text should be at least as long as its line count")
    return Result.Ok(lines)

fn sample_time() -> Result[int, RuntimeError]:
    seconds = unix_seconds()?
    millis = unix_millis()?
    assert(millis >= seconds * 1000, "expected unix millis to be at least seconds * 1000")
    return Result.Ok(1)

fn sample_yaml() -> Result[int, RuntimeError]:
    config = yaml_parse("service: alpha\nport: 7")?
    port = json_int(json_get(config, "port")?)?
    return Result.Ok(port)

fn sample_base64() -> Result[int, RuntimeError]:
    encoded = base64_encode("gof!")
    decoded = base64_decode(encoded)?
    return Result.Ok(len(encoded) + len(decoded))

fn sample_http_request() -> Result[int, RuntimeError]:
    headers: dict[string] = {"Accept": "application/json"}
    report = http_request("GET", "https://example.invalid/health", "", headers, 1500)?
    status = json_int(json_get(report, "status")?)?
    return Result.Ok(status)

fn sample_bytes_stream_net(path: string) -> Result[int, RuntimeError]:
    deadline: NetDeadline = deadline_after(1000)?
    payload: Bytes = bytes_from_string("hello")
    mut writer: WriteStream = open_write_stream(path)?
    writer = writer.with_deadline(deadline)
    writer.write_all(payload)?
    writer.flush()?
    writer.close()?
    mut reader: ReadStream = open_read_stream(path)?
    reader = reader.with_deadline(deadline)
    copy = reader.read_all()?
    listener: TcpListener = listen_tcp("127.0.0.1:0")?
    address: SocketAddr = listener.local_addr()?
    client: DuplexStream = connect_tcp(address.text())?
    return Result.Ok(bytes_len(copy) + address.port())

fn sample_tuples() -> Result[int, RuntimeError]:
    pair: (int, int) = (3, 4)
    (lo, hi) = pair
    return Result.Ok(pair.0 + hi)

fn sample_closures() -> int:
    add = fn (x: int, y: int) -> int:
        return x + y
    apply: fn(int) -> int = fn (x: int) -> int:
        return x * 2
    return add(1, 2) + apply(10)

protocol Shape:
    fn area(self: Self) -> int

struct Circle:
    radius: int

fn Circle.area(self: Circle) -> int:
    return self.radius * self.radius * 3

impl Circle: Shape

fn sample_generics() -> int:
    unsafe:
        return 0

fn describe[T: Shape](shape: T) -> int:
    return shape.area()

import testing

test fn smoke_test(t: TestContext):
    case = t.case("sum")
    case.equal(1 + 1, 2, "expected deterministic sum")

fixture(module) fn shared_total() -> int:
    return 41

fixture(test) fn scratch_dir(t: TestContext) -> TempDir:
    return t.temp_dir()

fn main() -> int:
    first = find_first([7, 8, 9])
    match first:
        Option.Some(value):
            assert(value == 7, "expected the first list element")
        Option.None:
            return 1
    return 0
