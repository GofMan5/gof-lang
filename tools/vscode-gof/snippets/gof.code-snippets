{
  "Module Skeleton": {
    "prefix": "gofmod",
    "body": [
      "module ${1:name}",
      "",
      "fn main() -> ${2:int}:",
      "    ${3:return 0}"
    ],
    "description": "Create a gof module with a typed main entrypoint"
  },
  "Function": {
    "prefix": "goffn",
    "body": [
      "fn ${1:name}(${2}) -> ${3:unit}:",
      "    ${4:return ()}"
    ],
    "description": "Create a gof function with an explicit return contract"
  },
  "Struct": {
    "prefix": "gofstruct",
    "body": [
      "struct ${1:Name}:",
      "    ${2:field}: ${3:int}"
    ],
    "description": "Create a gof struct declaration"
  },
  "Enum": {
    "prefix": "gofenum",
    "body": [
      "enum ${1:State}:",
      "    ${2:Ready}",
      "    ${3:Failed(message: string)}"
    ],
    "description": "Create a gof enum with unit and payload variants"
  },
  "Match Result": {
    "prefix": "gofmatch",
    "body": [
      "match ${1:value}:",
      "    Result.Ok(${2:ok}):",
      "        ${3:return ok}",
      "    Result.Err(${4:error}):",
      "        ${5:return Result.Err(error)}"
    ],
    "description": "Match over a Result value explicitly"
  },
  "Select": {
    "prefix": "gofselect",
    "body": [
      "select:",
      "    ${1:value} = recv(${2:ch}):",
      "        ${3:return value}",
      "    default:",
      "        ${4:return Result.Err(RuntimeError.Cancelled)}"
    ],
    "description": "Create a baseline select block with recv and default arms"
  },
  "Task Join": {
    "prefix": "gofawait",
    "body": [
      "${1:task}: task[${2:int}] = go ${3:work}()",
      "${4:outcome} = await_result(${1:task}, ${5:timeout_token(1000)})"
    ],
    "description": "Spawn a task and join it through the recoverable await_result path"
  },
  "Process Capture": {
    "prefix": "gofproc",
    "body": [
      "${1:report} = run_process(${2:\"gof\"}, [${3:\"--help\"}])?",
      "${4:status} = json_int(json_get(${1:report}, \"status\")?)?",
      "${5:stdout} = json_string(json_get(${1:report}, \"stdout\")?)?"
    ],
    "description": "Run a process explicitly and inspect the captured JSON report"
  },
  "Template Render": {
    "prefix": "goftmpl",
    "body": [
      "${1:context}: dict = {\"name\": ${2:\"gof\"}}",
      "${3:rendered} = template_render(${4:\"hello {{name}}\"}, ${1:context})?"
    ],
    "description": "Render explicit {{key}} placeholders from dict/json automation data"
  },
  "Stdin Report": {
    "prefix": "gofstdin",
    "body": [
      "${1:text} = read_stdin()?",
      "${2:lines} = read_stdin_lines()?",
      "${3:first_line} = first(${2:lines})?"
    ],
    "description": "Read one cached stdin snapshot as text and lines"
  },
  "Time Report": {
    "prefix": "goftime",
    "body": [
      "${1:seconds} = unix_seconds()?",
      "${2:millis} = unix_millis()?",
      "assert(${2:millis} >= ${1:seconds} * 1000, \"expected unix millis to be at least seconds * 1000\")"
    ],
    "description": "Capture explicit Unix wall-clock timestamps for automation scripts"
  },
  "Base64 Roundtrip": {
    "prefix": "gofb64",
    "body": [
      "${1:encoded} = base64_encode(${2:\"gof!\"})",
      "${3:decoded} = base64_decode(${1:encoded})?",
      "assert(${3:decoded} == ${2:\"gof!\"}, \"expected base64 roundtrip to preserve text\")"
    ],
    "description": "Encode and decode explicit base64 text payloads"
  },
  "HTTP Request Report": {
    "prefix": "gofhttp",
    "body": [
      "${1:headers}: dict[string] = {\"Accept\": \"application/json\"}",
      "${2:report} = http_request(${3:\"GET\"}, ${4:\"https://example.com/health\"}, \"\", ${1:headers}, ${5:1500})?",
      "${6:status} = json_int(json_get(${2:report}, \"status\")?)?"
    ],
    "description": "Send a structured HTTP request and inspect the bootstrap response report"
  },
  "Bytes Roundtrip": {
    "prefix": "gofbytes",
    "body": [
      "${1:payload}: Bytes = bytes_from_string(${2:\"hello\"})",
      "${3:decoded} = bytes_to_string(${1:payload})?",
      "assert(bytes_len(${1:payload}) == len(${3:decoded}), \"expected byte length to match decoded text length\")"
    ],
    "description": "Use the shipped bytes stdlib foundation through explicit Bytes helpers"
  },
  "Stream Roundtrip": {
    "prefix": "gofstream",
    "body": [
      "${1:deadline} = deadline_after(${2:1000})?",
      "mut ${3:writer}: WriteStream = open_write_stream(${4:\"roundtrip.txt\"})?",
      "${3:writer} = ${3:writer}.with_deadline(${1:deadline})",
      "${3:writer}.write_all(bytes_from_string(${5:\"hello\"}))?",
      "${3:writer}.flush()?",
      "${3:writer}.close()?",
      "mut ${6:reader}: ReadStream = open_read_stream(${4:\"roundtrip.txt\"})?",
      "${6:reader} = ${6:reader}.with_deadline(${1:deadline})",
      "${7:text} = ${6:reader}.read_all()?.to_string()?"
    ],
    "description": "Roundtrip bytes through explicit shipped io/time stdlib streams"
  },
  "TCP Roundtrip": {
    "prefix": "goftcp",
    "body": [
      "${1:deadline} = deadline_after(${2:1000})?",
      "${3:listener} = listen_tcp(${4:\"127.0.0.1:0\"})?.with_deadline(${1:deadline})",
      "${5:address} = ${3:listener}.local_addr()?",
      "${6:client} = connect_tcp_with_control(${5:address}.text(), ${1:deadline}, timeout_token(${7:1000}))?",
      "${6:client}.write_all(bytes_from_string(${8:\"ping\"}))?"
    ],
    "description": "Create an explicit TCP loopback baseline with deadlines and bytes payloads"
  },
  "YAML Config": {
    "prefix": "gofyaml",
    "body": [
      "${1:config} = yaml_parse(${2:\"service: alpha\\nport: 7\"})?",
      "${3:service} = json_string(json_get(${1:config}, \"service\")?)?",
      "${4:port} = json_int(json_get(${1:config}, \"port\")?)?"
    ],
    "description": "Parse YAML config text through the bootstrap json bridge"
  }
}
