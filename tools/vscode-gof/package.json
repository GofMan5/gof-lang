{
  "name": "gof-language",
  "displayName": "gof Language Support",
  "description": "Syntax highlighting, snippets, and compiler-backed diagnostics for the gof language.",
  "version": "0.2.2",
  "publisher": "gofman5",
  "icon": "media/gof-icon.png",
  "main": "./extension.cjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GofMan5/gof-lang.git"
  },
  "homepage": "https://github.com/GofMan5/gof-lang/tree/main/tools/vscode-gof",
  "bugs": {
    "url": "https://github.com/GofMan5/gof-lang/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "gof",
    "language",
    "syntax",
    "highlighting",
    "diagnostics",
    "snippets",
    "vscode"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "files": [
    "extension.cjs",
    "lib/**",
    "language-configuration.json",
    "media/**",
    "snippets/**",
    "syntaxes/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "activationEvents": [
    "onLanguage:gof",
    "onCommand:gof.showDiagnosticsOutput",
    "onCommand:gof.recheckActiveDocument"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gof",
        "aliases": [
          "gof"
        ],
        "extensions": [
          ".gof"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gof",
        "scopeName": "source.gof",
        "path": "./syntaxes/gof.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gof",
        "path": "./snippets/gof.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "gof.showDiagnosticsOutput",
        "title": "gof: Show Diagnostics Output"
      },
      {
        "command": "gof.recheckActiveDocument",
        "title": "gof: Recheck Active Document"
      }
    ],
    "configuration": {
      "title": "gof",
      "properties": {
        "gof.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable compiler-backed diagnostics for .gof files."
        },
        "gof.diagnostics.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "description": "Debounce delay in milliseconds before rerunning gof diagnostics after edits."
        },
        "gof.diagnostics.runOnSaveOnly": {
          "type": "boolean",
          "default": false,
          "description": "Only rerun gof diagnostics on save or manual refresh."
        },
        "gof.toolchain.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the gof executable used for compiler-backed diagnostics."
        },
        "gof.toolchain.useCargoFallback": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, use `cargo run -p gof-cli --bin gof -- ...` automatically inside the gof repository when no explicit toolchain path is configured."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test ./test/*.test.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.1"
  }
}
