import bytes
import http
import io
import net
import time

fn main() -> Result[int, RuntimeError]:
    report = json_parse("{\"status\":204,\"body\":\"{\\\"service\\\":\\\"alpha\\\",\\\"count\\\":7}\",\"headers\":{\"content-type\":[\"application/json; charset=utf-8\"]},\"method\":\"GET\",\"url\":\"https://example.com/health\"}")?
    json_headers: dict[string] = request_json_headers()
    bearer_headers: dict[string] = request_json_bearer_headers("demo-token")
    traced_headers: dict[string] = request_headers_set(bearer_headers, "X-Trace-Id", "trace-7")
    status = response_status(report)?
    status_class = response_status_class(report)?
    success = response_is_success(report)?
    body = response_json(report)?
    service = json_string(json_get(body, "service")?)?
    count = json_int(json_get(body, "count")?)?
    method = response_method(report)?
    url = response_url(report)?
    content_type = response_content_type(report)?
    accept = json_headers["Accept"]
    bearer = bearer_headers["Authorization"]
    json_content_type = json_headers["Content-Type"]
    trace_id = traced_headers["X-Trace-Id"]
    assert(status == 204, "expected parsed status")
    assert(success, "expected 2xx report to count as success")
    assert(service == "alpha", "expected response_json to parse body")
    assert(accept == "application/json", "expected JSON accept helper")
    assert(bearer == "Bearer demo-token", "expected bearer header helper")
    assert(json_content_type == "application/json", "expected JSON content type helper")
    assert(trace_id == "trace-7", "expected header setter helper")
    return Result.Ok(status + status_class + count + len(service) + len(method) + len(url) + len(content_type) + len(json_headers))
