import bytes
import http
import io
import net
import time

fn main() -> Result[int, RuntimeError]:
    report = json_parse("{\"status\":204,\"body\":\"ok\",\"headers\":{\"content-type\":[\"text/plain\"]},\"method\":\"GET\",\"url\":\"https://example.com/health\"}")?
    status = response_status(report)?
    body = response_body(report)?
    method = response_method(report)?
    url = response_url(report)?
    content_type = response_header(report, "content-type")?
    assert(status == 204, "expected parsed status")
    return Result.Ok(status + len(body) + len(method) + len(url) + len(content_type))
