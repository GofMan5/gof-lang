import bytes
import io
import time

fn main() -> Result[int, RuntimeError]:
    path = "target/bytes_stream_roundtrip.txt"
    deadline = deadline_after(1500)?
    payload = "gof-stdlib"

    mut writer = open_write_stream(path)?
    writer = writer.with_timeout(1500)?
    writer.write_all_string(payload)?
    writer.flush()?
    writer.close()?

    mut reader = open_read_stream(path)?
    reader = reader.with_timeout(1500)?
    text = reader.read_all_string()?
    reader.close()?

    assert(text == payload, "expected bytes roundtrip")
    assert(deadline.remaining_millis() >= 0, "deadline helper should stay non-negative")
    return Result.Ok(bytes_len(bytes_from_string(text)) + len(text))
