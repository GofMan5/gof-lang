import bytes
import net

fn serve(listener: TcpListener) -> Result[int, RuntimeError]:
    conn = listener.accept()?
    payload = conn.read_exact(5)?
    conn.write_all(payload)?
    peer = conn.peer_addr()?
    conn.close()?
    listener.close()?
    return Result.Ok(peer.port() - peer.port() + bytes_len(payload))

fn main() -> Result[int, RuntimeError]:
    mut listener = listen_tcp_loopback(0)?
    listener = listener.with_timeout(5000)?
    address = listener.local_addr()?
    server: task[Result[int, RuntimeError]] = go serve(listener)

    mut client = address.connect_tcp_with_timeout(5000)?
    client = client.with_timeout(5000)?
    payload = bytes_from_string("ping!")

    client.write_all(payload)?
    echoed = client.read_exact(5)?
    text = bytes_to_string(echoed)?
    local = client.local_addr()?
    client.close()?

    server_outcome = await server
    served = server_outcome?
    assert(text == "ping!", "expected tcp echo payload")
    assert(local.port() > 0, "expected a concrete local client port")
    return Result.Ok(served + len(text))
