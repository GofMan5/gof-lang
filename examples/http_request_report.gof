import http

fn main() -> Result[int, RuntimeError]:
    base = env("GOF_HTTP_REQUEST_BASE")?
    headers: dict[string] = request_json_bearer_headers_with("demo-token", {"Content-Type": "text/plain", "X-Trace-Id": "trace-7"})
    report = post_report_with_headers(base + "/inspect", "ping", headers, 1500)?
    status = response_status(report)?
    body = response_body(report)?
    method = response_method(report)?
    url = response_url(report)?
    content_type = response_content_type(report)?
    request_id = response_header(report, "x-request-id")?
    assert(status == 202, "expected accepted response")
    assert(response_is_success(report)?, "expected 202 report to count as success")
    assert(body == "accepted", "expected echoed response body")
    assert(method == "POST", "expected request method to round-trip")
    assert(url == base + "/inspect", "expected response report URL")
    assert(starts_with(content_type, "text/plain"), "expected content type header")
    return Result.Ok(status + len(body) + len(request_id))
