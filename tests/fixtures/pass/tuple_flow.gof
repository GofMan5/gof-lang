# Tuple walkthrough (RFC 0050): heterogeneous fixed-arity values with
# structural identity, destructuring everywhere, `.N` access, pairwise
# equality, lexicographic ordering, and value-semantics copying.

fn bounds() -> (int, int):
    return (1, 100)

fn main() -> int:
    # Literals are heterogeneous; types come from the members.
    pair: (int, string) = (1, "one")
    assert(pair.0 == 1, "expected the first member")
    assert(pair.1 == "one", "expected the second member")

    # Inferred tuple return types merge member-by-member.
    (lo, hi) = bounds()
    assert(lo == 1, "expected the low bound")
    assert(hi == 100, "expected the high bound")

    # Destructuring composes with mut distribution and nesting.
    mut (a, (b, c)) = (10, (20, 30))
    a = a + b + c
    assert(a == 60, "expected mut leaves to stay assignable")

    # Tuples flow through containers and loops.
    pairs: list[(int, int)] = [(1, 2), (3, 4), (10, 0)]
    mut total = 0
    for (x, y) in pairs:
        total = total + x * y
    assert(total == 14, "expected per-element destructuring in loops")

    # Swap reads as destructuring: the whole right-hand side evaluates
    # before any leaf binds.
    mut left = 1
    mut right = 2
    (left, right) = (right, left)
    assert(left == 2, "expected the swap to bind left first")
    assert(right == 1, "expected the swap to bind right second")

    # Equality is pairwise; ordering is lexicographic, left to right.
    assert((1, 2) == (1, 2), "expected structural equality")
    assert((1, 2) != (2, 1), "expected member order to matter")
    assert((1, 2) < (1, 3), "expected lexicographic ordering")
    assert((1, 2) < (2, 0), "expected the first member to dominate ordering")

    # Rendering follows the literal syntax.
    print(pair)
    print((1, (2, 3)))

    # Tuples nest with themselves and with Option/Result payloads.
    nested = ((1, 2), (3, 4))
    assert(nested.0 == (1, 2), "expected nested member access")
    assert(nested.1.0 == 3, "expected chained element access")
    return 0
