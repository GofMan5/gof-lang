fn main() -> int:
    ch: channel[int] = channel()
    close(ch)
    outcome = recv(ch)

    match outcome:
        Result.Ok(value):
            return value
        Result.Err(error):
            match error:
                RuntimeError.ChannelClosed:
                    return 7
                RuntimeError.Cancelled:
                    return 0
                RuntimeError.TaskFailed(message):
                    return len(message) - len(message)
                RuntimeError.TaskPanicked(task):
                    return len(task) - len(task)
                RuntimeError.ParseInt(message):
                    return len(message) - len(message)
                RuntimeError.EmptySequence(message):
                    return len(message) - len(message)
                RuntimeError.Slice(message):
                    return len(message) - len(message)
                RuntimeError.EnvMissing(name):
                    return len(name) - len(name)
                RuntimeError.Io(message):
                    return len(message) - len(message)
                RuntimeError.Utf8(message):
                    return len(message) - len(message)
                RuntimeError.NetDns(message):
                    return len(message) - len(message)
                RuntimeError.NetConnect(message):
                    return len(message) - len(message)
                RuntimeError.NetTimeout(message):
                    return len(message) - len(message)
                RuntimeError.NetTls(message):
                    return len(message) - len(message)
                RuntimeError.NetProxy(message):
                    return len(message) - len(message)
                RuntimeError.NetProtocol(message):
                    return len(message) - len(message)
                RuntimeError.NetReset(message):
                    return len(message) - len(message)
                RuntimeError.NetClosed:
                    return 0
                RuntimeError.Json(message):
                    return len(message) - len(message)
                RuntimeError.Csv(message):
                    return len(message) - len(message)
                RuntimeError.Toml(message):
                    return len(message) - len(message)
                RuntimeError.Template(message):
                    return len(message) - len(message)
                RuntimeError.Yaml(message):
                    return len(message) - len(message)
                RuntimeError.Base64(message):
                    return len(message) - len(message)
                RuntimeError.Time(message):
                    return len(message) - len(message)
                RuntimeError.HttpRequest(message):
                    return len(message) - len(message)
                RuntimeError.HttpStatus(code, body):
                    return code - code + len(body) - len(body)
