protocol Shape:
    fn area(self: Self) -> int

struct Circle:
    radius: int

fn Circle.area(self: Circle) -> int:
    return self.radius * self.radius * 3

impl Circle: Shape

fn announce[T: Shape](count: int, shape: T) -> string:
    return to_string(count) + to_string(shape.area())

fn main() -> int:
    print(announce("wrong", Circle(1)))
    return 0
