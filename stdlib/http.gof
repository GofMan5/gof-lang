fn response_status(report: json) -> Result[int, RuntimeError]:
    return json_int(json_get(report, "status")?)

fn request_json_headers() -> dict[string]:
    return {"Accept": "application/json", "Content-Type": "application/json"}

fn request_headers_set(headers: dict[string], name: string, value: string) -> dict[string]:
    return insert(headers, name, value)

fn request_bearer_headers(token: string) -> dict[string]:
    headers: dict[string] = dict()
    return request_headers_set(headers, "Authorization", "Bearer " + token)

fn request_json_bearer_headers(token: string) -> dict[string]:
    return request_headers_set(request_json_headers(), "Authorization", "Bearer " + token)

fn get_json(url: string) -> Result[json, RuntimeError]:
    return json_parse(http_get(url)?)

fn get_json_with_timeout(url: string, timeout_ms: int) -> Result[json, RuntimeError]:
    accept_headers: dict[string] = dict()
    report = http_request("GET", url, "", request_headers_set(accept_headers, "Accept", "application/json"), timeout_ms)?
    return response_json(report)

fn post_json(url: string, body: string) -> Result[json, RuntimeError]:
    return json_parse(http_post(url, body, "application/json")?)

fn post_json_with_timeout(url: string, body: string, timeout_ms: int) -> Result[json, RuntimeError]:
    return response_json(request_json_report("POST", url, body, timeout_ms)?)

fn request_json_report(method: string, url: string, body: string, timeout_ms: int) -> Result[json, RuntimeError]:
    return http_request(method, url, body, request_json_headers(), timeout_ms)

fn response_status_class(report: json) -> Result[int, RuntimeError]:
    return Result.Ok(response_status(report)? / 100)

fn response_is_success(report: json) -> Result[bool, RuntimeError]:
    status = response_status(report)?
    return Result.Ok(status >= 200 and status < 300)

fn response_body(report: json) -> Result[string, RuntimeError]:
    return json_string(json_get(report, "body")?)

fn response_json(report: json) -> Result[json, RuntimeError]:
    return json_parse(response_body(report)?)

fn response_method(report: json) -> Result[string, RuntimeError]:
    return json_string(json_get(report, "method")?)

fn response_url(report: json) -> Result[string, RuntimeError]:
    return json_string(json_get(report, "url")?)

fn response_headers(report: json) -> Result[json, RuntimeError]:
    return json_get(report, "headers")

fn response_header_values(report: json, name: string) -> Result[json, RuntimeError]:
    headers = response_headers(report)?
    return json_get(headers, name)

fn response_header(report: json, name: string) -> Result[string, RuntimeError]:
    values = response_header_values(report, name)?
    return json_string(json_index(values, 0)?)

fn response_content_type(report: json) -> Result[string, RuntimeError]:
    return response_header(report, "content-type")

